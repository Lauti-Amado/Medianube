{
  "name": "medianube-backend",
  "version": "0.2.0",
  "private": true,
  "description": "Backend serverless de Medianube (AWS Lambda + DynamoDB), arquitectura hexagonal en TypeScript",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  }
}
